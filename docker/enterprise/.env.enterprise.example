# ==============================================================================
# PENPOT ENTERPRISE PLATFORM ENVIRONMENT DEFAULTS (TEMPLATE)
# ==============================================================================
# Copy this file to .env.enterprise and configure your production values.
# DO NOT commit .env.enterprise with production secrets to GitHub.
# ==============================================================================

PENPOT_VERSION=2.17.2
PENPOT_PORT=9001
PENPOT_PUBLIC_URI=http://localhost:9001

# Enterprise Secret Key (Generate a random Base64 512-bit key for production)
PENPOT_SECRET_KEY=change-this-insecure-enterprise-key-512bit-token

# Database
POSTGRES_USER=penpot
POSTGRES_PASSWORD=penpot_enterprise_sec_pwd
POSTGRES_PORT=5432

# In-Memory Cache
VALKEY_PORT=6379

# Development Mailcatcher Web UI
MAILCATCHER_PORT=1080

# Enterprise Feature Toggles
ENABLE_MULTI_ORG=true
ENABLE_ENTERPRISE_RBAC=true
ENABLE_ENTERPRISE_SSO=true
ENABLE_ENTERPRISE_AUDIT=true
ENABLE_AI_GOVERNANCE=true
